        "# we prefix our text with\n",
        "prefix = \"Please answer this question\"\n",
        "\n",
        "\n",
        "def preprocess_function(examples):\n",
        "  # inputs = tokenized answer\n",
        "  inputs = [prefix + doc for doc in examples[\"question\"]]\n",
        "  model_inputs = tokenizer(inputs, max_length=128, truncation=True)\n",
        "\n",
        "  # labels = tokenized outputs\n",
        "  labels = tokenizer(text_target=examples[\"answer_text\"],\n",
        "                     max_length=128,\n",
        "                     padding=\"max_length\",\n",
        "                     truncation=True)\n",
        "\n",
        "  model_inputs['labels'] = labels[\"input_ids\"]\n",
        "  return model_inputs"
      ],
      "metadata": {
        "id": "yrWZyf71UpPh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# map preprocessing fun across dataset\n",
        "\n",
        "tokenized_dataset = split_dataset.map(preprocess_function,\n",
        "                                      batched=True)"
      ],
